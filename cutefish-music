#!/usr/bin/env python3
import os, json, gettext, subprocess, webview

t = gettext.translation("cutefish-music", localedir="/usr/share/locale", fallback=True)
_ = t.gettext
CFG = os.path.expanduser("~/.config/cutefish-music.json")

def sys_theme():
    try:
        out = subprocess.check_output(
            ["gdbus", "call", "--session", "--dest", "org.cutefish.Services",
             "--object-path", "/org/cutefish/Services/Appearance",
             "--method", "org.freedesktop.DBus.Properties.GetAll", ""],
            stderr=subprocess.DEVNULL
        ).decode().lower()
        if "'isdarkmode': <false>" in out: return "light"
        if "'isdarkmode': <true>" in out: return "dark"
    except Exception:
        pass
    return "dark"

class API:
    def __init__(self):
        self.proc = None
        self.paused = False

    def load(self):
        c = json.load(open(CFG)) if os.path.exists(CFG) else {"dir": os.path.expanduser("~/Music"), "fav": [], "theme": "auto"}
        tracks = []
        d = c.get("dir", os.path.expanduser("~/Music"))
        if os.path.isdir(d):
            for r, dirs, fs in os.walk(d):
                for f in sorted(fs):
                    if f.lower().endswith((".mp3", ".flac", ".ogg", ".wav", ".m4a")):
                        tracks.append({"p": os.path.join(r, f), "n": next(iter(os.path.splitext(f)))})
        saved = c.get("theme", "auto")
        active = sys_theme() if saved == "auto" else saved
        return {"tracks": tracks, "fav": c.get("fav", []), "theme": saved, "active": active, "t": {"m": _("Music"), "s": _("Search..."), "a": _("All"), "f": _("Favorites"), "d": _("Folder")}}

    def get_sys_theme(self):
        return sys_theme()

    def save_cfg(self, data):
        c = json.load(open(CFG)) if os.path.exists(CFG) else {"dir": os.path.expanduser("~/Music"), "fav": [], "theme": "auto"}
        c.update(data)
        json.dump(c, open(CFG, "w"))

    def play(self, path):
        if self.proc: self.proc.terminate()
        self.paused = False
        self.proc = subprocess.Popen(["mpv", "--no-video", "--really-quiet", path])
        return True

    def toggle(self):
        if not self.proc or self.proc.poll() is not None: return False
        os.kill(self.proc.pid, 19 if not self.paused else 18)
        self.paused = not self.paused
        return not self.paused

    def pick(self):
        r = window.create_file_dialog(webview.FOLDER_DIALOG)
        if r:
            d = next(iter(r)) if isinstance(r, (list, tuple)) else str(r)
            self.save_cfg({"dir": d})
            return self.load()

    def fav(self, lst):
        self.save_cfg({"fav": lst})

    def win(self, a):
        if a == "c":
            if self.proc: self.proc.terminate()
            window.destroy()
        elif a == "m": window.minimize()
        elif a == "x": window.maximize()

